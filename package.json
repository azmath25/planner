{
  "name": "dayframe-web",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build && node scripts/finalize-site.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test:source": "node tests/source-smoke.mjs && node --test tests/insights-harness-code.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:time": "node --experimental-strip-types --test tests/time-tracking.test.mjs",
    "test:api": "node --test backend/tests/*.test.mjs",
    "test:documents": "node --experimental-strip-types --test tests/documentBlocks.test.mjs",
    "test:pwa": "node --test tests/pwa-worker.test.mjs"
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/mantine": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@neondatabase/auth": "0.7.0-beta",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "esbuild": "^0.28.0"
  },
  "overrides": {
    "better-auth": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "zod": "4.6.6"
  }
}
